Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Q", "[", "\[Eta]", "]"}], "/.", 
         RowBox[{"{", 
          RowBox[{"\[Eta]", "\[Rule]", 
           RowBox[{
            FractionBox[
             RowBox[{"Abs", "[", "\[Mu]", "]"}], "2"], "+", 
            FractionBox[
             RowBox[{"Log", "[", 
              RowBox[{"-", 
               FractionBox[
                RowBox[{
                 RowBox[{"-", "1"}], "+", "p1"}], 
                RowBox[{"h", " ", "p1"}]]}], "]"}], 
             RowBox[{"Abs", "[", "\[Mu]", "]"}]]}]}], "}"}]}], "/.", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"p1", "->", ".5"}], ",", 
          RowBox[{"\[Mu]", "->", "\[Mu]tmp"}]}], "}"}]}], ",", 
