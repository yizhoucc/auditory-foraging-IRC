 RowBox[{
  RowBox[{
   RowBox[{"Q", "[", "x_", "]"}], ":=", 
   RowBox[{
    RowBox[{"1", "/", "2"}], " ", 
    RowBox[{"Erfc", "[", 
     RowBox[{"x", "/", 
      RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.908983236249605*^9, 3.9089832376710033`*^9}},
 CellLabel->"In[1]:=",ExpressionUUID->"40ed25d2-e709-45e4-aa64-0c34f9a65cac"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rew", " ", "=", 
   RowBox[{
    RowBox[{"h", " ", "*", " ", "p1", " ", "*", " ", 
     RowBox[{"Q", "[", 
      RowBox[{"\[Eta]", "-", 
       RowBox[{"Abs", "[", "\[Mu]", "]"}]}], "]"}]}], "+", 
    RowBox[{"f", " ", "*", " ", 
     RowBox[{"(", 
      RowBox[{"1", "-", "p1"}], ")"}], " ", "*", "  ", 
     RowBox[{"Q", "[", "\[Eta]", "]"}]}], "-", 
    SuperscriptBox["\[Mu]", "2"]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.90898433734282*^9, 3.908984343351201*^9}, {
