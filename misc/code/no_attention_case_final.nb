Cell[BoxData[
 TagBox[
  StyleBox[
   DynamicModuleBox[{$CellContext`noSigNodes$$ = 50, $CellContext`p$$ = 
    0.012, $CellContext`rFA$$ = -0.32399999999998386`, $CellContext`rFood$$ = 
    0.165, $CellContext`rMiss$$ = 0, Typeset`show$$ = True, 
