       ",", " ", "missReward"}], "}"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"faReward", "[", "t_", "]"}], ":=", 
       RowBox[{"Piecewise", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"rFA", ",", 
            RowBox[{"t", "==", "0"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"rFA", "*", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "-", "p"}], ")"}], "^", "t"}]}], ",", 
            RowBox[{"1", "<=", "t", "<=", 
             RowBox[{"(", 
              RowBox[{"noSigNodes", "-", "1"}], ")"}]}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"rFA", "*", 
             RowBox[{
              RowBox[{"(", 
               RowBox[{"1", "-", "p"}], ")"}], "^", "t"}]}], ",", 
            RowBox[{"t", ">", 
             RowBox[{"(", 
              RowBox[{"noSigNodes", "-", "1"}], ")"}]}]}], "}"}]}], "}"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"foodReward", "[", "t_", "]"}], ":=", 
       RowBox[{"Piecewise", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"t", "==", "0"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"rFood", "*", 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"1", "-", "p"}], ")"}], "t"]}], ")"}]}], ",", 
            RowBox[{"1", "<=", "t", "<=", 
             RowBox[{"(", 
              RowBox[{"noSigNodes", "-", "1"}], ")"}]}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"rFood", "*", 
             SuperscriptBox[
              RowBox[{"(", 
               RowBox[{"1", "-", "p"}], ")"}], 
              RowBox[{"t", "-", 
               RowBox[{"(", 
                RowBox[{"noSigNodes", "-", "1"}], ")"}]}]], "*", 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"1", "-", "p"}], ")"}], 
                RowBox[{"(", 
                 RowBox[{"noSigNodes", "-", "1"}], ")"}]]}], ")"}]}], ",", 
            RowBox[{"t", ">", 
             RowBox[{"(", 
              RowBox[{"noSigNodes", "-", "1"}], ")"}]}]}], "}"}]}], "}"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"missReward", "[", "t_", "]"}], ":=", 
       RowBox[{"Piecewise", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"t", "==", "0"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"0", ",", 
            RowBox[{"1", "<=", "t", "<=", 
             RowBox[{"(", 
              RowBox[{"noSigNodes", "-", "1"}], ")"}]}]}], "}"}], ",", 
          "\[IndentingNewLine]", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"rMiss", "*", 
             RowBox[{"(", 
              RowBox[{"1", "-", 
               SuperscriptBox[
                RowBox[{"(", 
                 RowBox[{"1", "-", "p"}], ")"}], 
                RowBox[{"t", "-", 
                 RowBox[{"(", 
                  RowBox[{"noSigNodes", "-", "1"}], ")"}]}]]}], ")"}]}], ",", 
            
            RowBox[{"t", ">", 
             RowBox[{"(", 
              RowBox[{"noSigNodes", "-", "1"}], ")"}]}]}], "}"}]}], "}"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
