       Hold[$CellContext`p$$], 0.012, "Transition prob."}, 0, 1, 0.001}, {{
       Hold[$CellContext`rFA$$], -0.15, "rFA"}, -200, 0, 0.001}, {{
       Hold[$CellContext`rFood$$], 0.125, "rFood"}, 0, 200, 0.001}, {{
       Hold[$CellContext`rMiss$$], 0, "rMiss"}, -10, 0, 0.1}}, 
    Typeset`size$$ = {643., {138., 144.}}, Typeset`update$$ = 0, 
    Typeset`initDone$$, Typeset`skipInitDone$$ = True}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, 
      "Variables" :> {$CellContext`noSigNodes$$ = 50, $CellContext`p$$ = 
        0.012, $CellContext`rFA$$ = -0.15, $CellContext`rFood$$ = 
        0.125, $CellContext`rMiss$$ = 0}, "ControllerVariables" :> {}, 
      "OtherVariables" :> {
       Typeset`show$$, Typeset`bookmarkList$$, Typeset`bookmarkMode$$, 
        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$}, "Body" :> 
      Module[{$CellContext`t$, $CellContext`totReward$, \
$CellContext`faReward$, $CellContext`foodReward$, $CellContext`missReward$}, \
$CellContext`faReward$[
           Pattern[$CellContext`t$, 
            Blank[]]] := 
         Piecewise[{{$CellContext`rFA$$, $CellContext`t$ == 
             0}, {$CellContext`rFA$$ (1 - $CellContext`p$$)^$CellContext`t$, 
             1 <= $CellContext`t$ <= $CellContext`noSigNodes$$ - 
              1}, {$CellContext`rFA$$ (
               1 - $CellContext`p$$)^$CellContext`t$, $CellContext`t$ > \
$CellContext`noSigNodes$$ - 1}}]; $CellContext`foodReward$[
           Pattern[$CellContext`t$, 
            Blank[]]] := 
         Piecewise[{{
            0, $CellContext`t$ == 
             0}, {$CellContext`rFood$$ (
              1 - (1 - $CellContext`p$$)^$CellContext`t$), 
             1 <= $CellContext`t$ <= $CellContext`noSigNodes$$ - 
              1}, {$CellContext`rFood$$ (
               1 - $CellContext`p$$)^($CellContext`t$ - \
($CellContext`noSigNodes$$ - 1)) (
              1 - (1 - $CellContext`p$$)^($CellContext`noSigNodes$$ - 
               1)), $CellContext`t$ > $CellContext`noSigNodes$$ - 
              1}}]; $CellContext`missReward$[
           Pattern[$CellContext`t$, 
            Blank[]]] := 
         Piecewise[{{0, $CellContext`t$ == 0}, {
            0, 1 <= $CellContext`t$ <= $CellContext`noSigNodes$$ - 
              1}, {$CellContext`rMiss$$ (
              1 - (1 - $CellContext`p$$)^($CellContext`t$ - \
($CellContext`noSigNodes$$ - 
               1))), $CellContext`t$ > $CellContext`noSigNodes$$ - 
              1}}]; $CellContext`totReward$[
           Pattern[$CellContext`t$, 
            Blank[]]] := 
         Piecewise[{{$CellContext`rFA$$, $CellContext`t$ == 
             0}, {$CellContext`rFA$$ (
                1 - $CellContext`p$$)^$CellContext`t$ + $CellContext`rFood$$ (
               1 - (1 - $CellContext`p$$)^$CellContext`t$), 
             1 <= $CellContext`t$ <= $CellContext`noSigNodes$$ - 
              1}, {$CellContext`rFA$$ (
                1 - $CellContext`p$$)^$CellContext`t$ + $CellContext`rFood$$ (
                1 - $CellContext`p$$)^($CellContext`t$ - \
($CellContext`noSigNodes$$ - 1)) (
               1 - (1 - $CellContext`p$$)^($CellContext`noSigNodes$$ - 
                1)) + $CellContext`rMiss$$ (
               1 - (1 - $CellContext`p$$)^($CellContext`t$ - \
($CellContext`noSigNodes$$ - 
                1))), $CellContext`t$ > $CellContext`noSigNodes$$ - 1}}]; 
        Plot[{
           $CellContext`faReward$[$CellContext`t$], 
           $CellContext`foodReward$[$CellContext`t$], 
           $CellContext`missReward$[$CellContext`t$], 
           $CellContext`totReward$[$CellContext`t$]}, {$CellContext`t$, 0, 
           100}, AxesLabel -> {"t", "Output"}, 
          PlotLegends -> {
           "False alarm reward", "Food reward", "Miss reward", 
            "Total reward"}, PlotRange -> All]], 
      "Specifications" :> {{{$CellContext`noSigNodes$$, 50, "noSigNodes"}, 1, 
