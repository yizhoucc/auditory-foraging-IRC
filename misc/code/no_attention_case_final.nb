            RowBox[{
             RowBox[{"rFA", "*", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "-", "p"}], ")"}], "^", "t"}]}], "+", 
             RowBox[{"rFood", "*", 
              SuperscriptBox[
               RowBox[{"(", 
                RowBox[{"1", "-", "p"}], ")"}], 
               RowBox[{"t", "-", 
                RowBox[{"(", 
                 RowBox[{"noSigNodes", "-", "1"}], ")"}]}]], "*", 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"1", "-", "p"}], ")"}], 
                 RowBox[{"(", 
                  RowBox[{"noSigNodes", "-", "1"}], ")"}]]}], ")"}]}], "+", 
             RowBox[{"rMiss", "*", 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"1", "-", "p"}], ")"}], 
                 RowBox[{"t", "-", 
                  RowBox[{"(", 
                   RowBox[{"noSigNodes", "-", "1"}], ")"}]}]]}], ")"}]}]}], 
            ",", 
            RowBox[{"t", ">", 
             RowBox[{"(", 
              RowBox[{"noSigNodes", "-", "1"}], ")"}]}]}], "}"}]}], "}"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"faReward", "[", "t", "]"}], ",", 
          RowBox[{"foodReward", "[", "t", "]"}], ",", " ", 
          RowBox[{"missReward", "[", "t", "]"}], ",", 
          RowBox[{"totReward", "[", "t", "]"}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"t", ",", "0", ",", "100"}], "}"}], ",", 
        RowBox[{"AxesLabel", "->", 
         RowBox[{"{", 
          RowBox[{"\"\<t\>\"", ",", "\"\<Output\>\""}], "}"}]}], ",", 
        RowBox[{"PlotLegends", "->", 
         RowBox[{"{", 
