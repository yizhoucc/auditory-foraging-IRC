        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"rFA", ",", 
            RowBox[{"t", "==", "0"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"rFA", "*", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"1", "-", "p"}], ")"}], "^", "t"}]}], "+", 
             RowBox[{"rFood", "*", 
              RowBox[{"(", 
               RowBox[{"1", "-", 
                SuperscriptBox[
                 RowBox[{"(", 
                  RowBox[{"1", "-", "p"}], ")"}], "t"]}], ")"}]}]}], ",", 
