        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"rtot", "[", 
            RowBox[{
            "\[Mu]", ",", "\[Eta]1", ",", "\[Eta]2", ",", "h", ",", "f"}], 
            "]"}], ",", 
           RowBox[{"\[Mu]", ">=", "0"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Mu]", ",", "\[Eta]1", ",", "\[Eta]2"}], "}"}]}], "]"}]}],
       ";", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"minValue", ",", "argMin"}], "}"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"h", ",", "hStart", ",", "hEnd", ",", "hInc"}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"totCostValues", "=", 
   RowBox[{"First", "/@", "sols"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"\[Mu]Values", "=", 
   RowBox[{"\[Mu]", "/.", " ", 
    RowBox[{"Last", "/@", "sols"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
