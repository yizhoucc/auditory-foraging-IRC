Cell["Had we been assuming a miss cost.", "Subsubsection",
 CellChangeTimes->{{3.9165062605099087`*^9, 
  3.916506326320755*^9}},ExpressionUUID->"936ad58e-8c9e-4163-aab2-\
514c03531f19"],

Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{"p01", "[", 
     RowBox[{"\[Mu]_", ",", "\[Eta]1_", ",", "\[Eta]2_"}], "]"}], " ", "=", 
    " ", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Q", "[", 
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"\[Eta]2", "+", "o1"}], ")"}]}], "]"}], " ", "*", 
       RowBox[{"cp11", "[", 
        RowBox[{"\[Mu]", ",", "o1"}], "]"}], "*", "do"}], ",", 
      RowBox[{"{", 
       RowBox[{"o1", ",", "dmin", ",", "\[Eta]1", ",", "do"}], "}"}]}], 
     "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"p02", "[", 
     RowBox[{"\[Mu]_", ",", "\[Eta]1_", ",", "\[Eta]2_"}], "]"}], "=", 
    RowBox[{"Sum", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Q", "[", 
        RowBox[{"-", 
         RowBox[{"(", 
          RowBox[{"\[Eta]2", "+", "o1", "-", "\[Mu]"}], ")"}]}], "]"}], " ", 
       "*", 
       RowBox[{"cp12", "[", "o1", "]"}], "*", "do"}], ",", 
      RowBox[{"{", 
       RowBox[{"o1", ",", "dmin", ",", "\[Eta]1", ",", "do"}], "}"}]}], 
     "]"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"rtot", "[", 
     RowBox[{
     "\[Mu]_", ",", "\[Eta]1_", ",", "\[Eta]2_", ",", "h_", ",", "f_"}], 
     "]"}], " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["\[Mu]", "2"]}], " ", "+", " ", 
      RowBox[{"p1", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"r01", "  ", 
          RowBox[{"p01", "[", 
           RowBox[{"\[Mu]", ",", "\[Eta]1", ",", "\[Eta]2"}], "]"}]}], " ", 
         "+", " ", 
         RowBox[{"r11", " ", 
          RowBox[{"p11", "[", 
           RowBox[{"\[Mu]", ",", "\[Eta]1"}], "]"}]}], " ", "+", " ", 
         RowBox[{"r21", " ", 
          RowBox[{"p21", "[", 
           RowBox[{"\[Mu]", ",", "\[Eta]1", ",", "\[Eta]2"}], "]"}]}]}], 
        ")"}]}], "+", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", "-", "p1"}], ")"}], 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"r02", "  ", 
          RowBox[{"p02", "[", 
           RowBox[{"\[Mu]", ",", "\[Eta]1", ",", "\[Eta]2"}], "]"}]}], " ", 
         "+", " ", 
         RowBox[{"r12", " ", 
          RowBox[{"p12", "[", "\[Eta]1", "]"}]}], " ", "+", " ", 
         RowBox[{"r22", " ", 
          RowBox[{"p22", "[", 
           RowBox[{"\[Mu]", ",", "\[Eta]1", ",", "\[Eta]2"}], "]"}]}]}], 
        ")"}]}]}], "/.", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"r01", "->", "0"}], " ", ",", 
       RowBox[{"r11", "->", "h"}], ",", 
       RowBox[{"r21", "->", "f"}], " ", ",", 
       RowBox[{"r02", "->", " ", "0"}], ",", 
       RowBox[{"r12", "->", "f"}], " ", ",", 
       RowBox[{"r22", "->", "h"}]}], " ", "}"}]}]}], ";"}], "*)"}]], "Input",
 CellChangeTimes->{{3.9165018056597853`*^9, 3.916501940483939*^9}, 
