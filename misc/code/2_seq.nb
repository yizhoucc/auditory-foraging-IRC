Cell[CellGroupData[{

Cell["Using Sum and assuming no missing cost.", "Subsubsection",
 CellChangeTimes->{{3.9165062605099087`*^9, 3.916506326320755*^9}, {
  3.9165063983513403`*^9, 
  3.916506410513791*^9}},ExpressionUUID->"b29fb40e-29e8-49f9-86d1-\
28052806ee05"],

Cell[BoxData[{
 RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Q", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"1", "/", "2"}], " ", 
   RowBox[{"Erfc", "[", 
    RowBox[{"x", "/", 
     RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}]}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cp11", "[", 
    RowBox[{"\[Mu]_", ",", "o1_"}], "]"}], " ", "=", " ", 
   RowBox[{"PDF", "[", 
    RowBox[{
     RowBox[{"NormalDistribution", "[", 
      RowBox[{"\[Mu]", ",", "1"}], "]"}], ",", "o1"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cp12", "[", "o1_", "]"}], "=", " ", 
   RowBox[{"PDF", "[", 
    RowBox[{
     RowBox[{"NormalDistribution", "[", 
      RowBox[{"0", ",", "1"}], "]"}], ",", "o1"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p11", "[", 
    RowBox[{"\[Mu]_", ",", "\[Eta]1_"}], "]"}], "=", 
   RowBox[{"Q", "[", 
    RowBox[{"(", 
     RowBox[{"\[Eta]1", "-", "\[Mu]"}], ")"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p21", "[", 
    RowBox[{"\[Mu]_", ",", "\[Eta]1_", ",", "\[Eta]2_"}], "]"}], "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Q", "[", 
       RowBox[{"(", 
        RowBox[{"\[Eta]2", "+", "o1"}], ")"}], "]"}], " ", "*", 
      RowBox[{"cp11", "[", 
       RowBox[{"\[Mu]", ",", "o1"}], "]"}], "*", "do"}], ",", 
     RowBox[{"{", 
      RowBox[{"o1", ",", "dmin", ",", "\[Eta]1", ",", "do"}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p12", "[", "\[Eta]1_", "]"}], "=", 
   RowBox[{"Q", "[", "\[Eta]1", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"p22", "[", 
    RowBox[{"\[Mu]_", ",", "\[Eta]1_", ",", "\[Eta]2_"}], "]"}], "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Q", "[", 
       RowBox[{"(", 
        RowBox[{"\[Eta]2", "+", "o1", "-", "\[Mu]"}], ")"}], "]"}], " ", "*", 
      
      RowBox[{"cp12", "[", "o1", "]"}], "*", "do"}], ",", 
     RowBox[{"{", 
      RowBox[{"o1", ",", "dmin", ",", "\[Eta]1", ",", "do"}], "}"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"faProb", "[", 
    RowBox[{"\[Mu]_", ",", "\[Eta]1_", ",", "\[Eta]2_"}], "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"p1", " ", 
      RowBox[{"p21", "[", 
       RowBox[{"\[Mu]", ",", "\[Eta]1", ",", "\[Eta]2"}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "p1"}], ")"}], " ", 
      RowBox[{"p12", "[", "\[Eta]1", "]"}]}]}], ")"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"hitProb", "[", 
    RowBox[{"\[Mu]_", ",", "\[Eta]1_", ",", "\[Eta]2_"}], "]"}], ":=", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"p1", " ", 
      RowBox[{"p11", "[", 
       RowBox[{"\[Mu]", ",", "\[Eta]1"}], "]"}]}], "+", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "-", "p1"}], ")"}], " ", 
      RowBox[{"p22", "[", 
       RowBox[{"\[Mu]", ",", "\[Eta]1", ",", "\[Eta]2"}], "]"}]}]}], ")"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rtot", "[", 
    RowBox[{
    "\[Mu]_", ",", "\[Eta]1_", ",", "\[Eta]2_", ",", "h_", ",", "f_"}], "]"}],
    " ", "=", " ", 
   RowBox[{
    RowBox[{"-", 
     SuperscriptBox["\[Mu]", "2"]}], " ", "+", " ", 
    RowBox[{"h", "*", 
     RowBox[{"hitProb", "[", 
      RowBox[{"\[Mu]", ",", "\[Eta]1", ",", "\[Eta]2"}], "]"}]}], "+", " ", 
    RowBox[{"f", "*", 
     RowBox[{"faProb", "[", 
      RowBox[{"\[Mu]", ",", "\[Eta]1", ",", "\[Eta]2"}], "]"}]}]}]}], 
  ";"}]}], "Input",
