   RowBox[{"\[Eta]2", "/.", " ", 
    RowBox[{"Last", "/@", "sols"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"xValues", " ", "=", " ", 
   RowBox[{"Range", "[", 
    RowBox[{"hStart", ",", "hEnd", ",", "hInc"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"faProbValues", "=", 
   RowBox[{"Quiet", "[", 
