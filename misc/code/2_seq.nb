Cell[BoxData[
 RowBox[{"(*", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"Clear", "[", "\"\<Global`*\>\"", "]"}], "\[IndentingNewLine]", 
     RowBox[{"Q", "[", "x_", "]"}]}], ":=", 
    RowBox[{
     RowBox[{
      RowBox[{"1", "/", "2"}], " ", 
      RowBox[{"Erfc", "[", 
       RowBox[{"x", "/", 
        RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}], "\[IndentingNewLine]", 
      "cp11"}], "=", " ", 
     RowBox[{"PDF", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"\[Mu]", ",", "1"}], "]"}], ",", "o1"}], "]"}]}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"cp12", "=", " ", 
    RowBox[{"PDF", "[", 
     RowBox[{
      RowBox[{"NormalDistribution", "[", 
       RowBox[{"0", ",", "1"}], "]"}], ",", "o1"}], "]"}]}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"opt", " ", "=", " ", "20"}], ";", "\[IndentingNewLine]", 
   RowBox[{"defaultLargeNot", " ", "=", " ", "10"}], ";", 
   "\[IndentingNewLine]", 
   RowBox[{"p1Val", " ", "=", " ", "0.5"}], ";", "\[IndentingNewLine]", 
   RowBox[{"fVal", " ", "=", " ", 
    RowBox[{"-", "2"}]}], ";", "\[IndentingNewLine]", 
   RowBox[{"hStart", " ", "=", "1.2"}], ";", "\[IndentingNewLine]", 
   RowBox[{"hEnd", " ", "=", " ", "3"}], ";", "\[IndentingNewLine]", 
   RowBox[{"hInc", " ", "=", " ", "0.1"}], ";", "\[IndentingNewLine]", 
   RowBox[{"sols", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"minValue", ",", "argMin"}], "}"}], "=", 
        RowBox[{"NMaximize", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{
                RowBox[{"p1", " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"h", " ", "p11"}], "+", 
                   RowBox[{"f", " ", "p21"}]}], ")"}]}], "+", 
                RowBox[{
                 RowBox[{"(", 
                  RowBox[{"1", "-", "p1"}], ")"}], " ", 
                 RowBox[{"(", 
                  RowBox[{
                   RowBox[{"f", " ", "p12"}], "+", 
                   RowBox[{"h", " ", "p22"}]}], ")"}]}], "-", 
                RowBox[{"\[Mu]", "^", "2"}]}], ")"}], "/.", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"p1", "->", "p1Val"}], ",", 
                RowBox[{"f", "->", "fVal"}]}], "}"}]}], "/.", " ", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"p01", "->", 
                RowBox[{"NIntegrate", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Q", "[", 
                    RowBox[{"-", 
                    RowBox[{"(", 
                    RowBox[{"\[Eta]2", "+", "o1"}], ")"}]}], "]"}], " ", 
                   "cp11"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"o1", ",", 
                    RowBox[{"-", "\[Infinity]"}], ",", "\[Eta]1"}], "}"}], 
                  ",", 
                  RowBox[{"MaxRecursion", "->", "opt"}]}], "]"}]}], ",", 
               RowBox[{"p11", "->", 
                RowBox[{"Q", "[", 
                 RowBox[{"(", 
                  RowBox[{"\[Eta]1", "-", "\[Mu]"}], ")"}], "]"}]}], ",", 
               RowBox[{"p21", "->", 
                RowBox[{"NIntegrate", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Q", "[", 
                    RowBox[{"(", 
                    RowBox[{"\[Eta]2", "+", "o1"}], ")"}], "]"}], " ", 
                   "cp11"}], ",", 
                  RowBox[{"{", 
                   RowBox[{"o1", ",", 
                    RowBox[{"-", "\[Infinity]"}], ",", "\[Eta]1"}], "}"}], 
                  ",", 
                  RowBox[{"MaxRecursion", "->", "opt"}]}], "]"}]}], ",", 
               RowBox[{"p02", "->", 
                RowBox[{"NIntegrate", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"Q", "[", 
                    RowBox[{"-", 
                    RowBox[{"(", 
