        Typeset`animator$$, Typeset`animvar$$, Typeset`name$$, 
        Typeset`specs$$, Typeset`size$$, Typeset`update$$, Typeset`initDone$$,
         Typeset`skipInitDone$$}, "Body" :> Plot[{
         ReplaceAll[
          $CellContext`Q[$CellContext`\[Eta] - Abs[$CellContext`\[Mu]]], {
           Part[
            NMaximize[
             
             ReplaceAll[{$CellContext`h $CellContext`Q[$CellContext`\[Eta] - 
                  Abs[$CellContext`\[Mu]]] + $CellContext`f \
$CellContext`Q[$CellContext`\[Eta]] - $CellContext`\[Mu]^2}, {$CellContext`f -> \
$CellContext`ftmp$$}], {$CellContext`\[Eta], $CellContext`\[Mu]}], 
