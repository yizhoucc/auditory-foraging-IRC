    516., {130., 137.}}, Typeset`update$$ = 0, Typeset`initDone$$, 
    Typeset`skipInitDone$$ = True}, 
    DynamicBox[Manipulate`ManipulateBoxes[
     1, StandardForm, "Variables" :> {$CellContext`ftmp$$ = -5}, 
      "ControllerVariables" :> {}, 
      "OtherVariables" :> {
