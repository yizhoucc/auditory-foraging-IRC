Cell[BoxData[
 RowBox[{"Manipulate", "[", 
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Q", "[", 
        RowBox[{"\[Eta]", "-", 
         RowBox[{"Abs", "[", "\[Mu]", "]"}]}], "]"}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"NMaximize", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"h", " ", "*", " ", 
               RowBox[{"Q", "[", 
                RowBox[{"\[Eta]", "-", 
                 RowBox[{"Abs", "[", "\[Mu]", "]"}]}], "]"}]}], "+", 
              RowBox[{"f", " ", 
               RowBox[{"Q", "[", "\[Eta]", "]"}]}], "-", 
              SuperscriptBox["\[Mu]", "2"]}], "}"}], "/.", 
            RowBox[{"{", 
             RowBox[{"f", "->", " ", "ftmp"}], "}"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Eta]", ",", "\[Mu]"}], "}"}]}], "]"}], "[", 
         RowBox[{"[", "2", "]"}], "]"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"h", ",", "0", ",", "20"}], "}"}], ",", 
     RowBox[{"PlotLegends", "->", 
      RowBox[{"{", "Automatic", "}"}]}], ",", 
     RowBox[{"AxesLabel", "->", "Automatic"}], ",", " ", 
     RowBox[{"PlotRange", "->", "All"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"ftmp", ",", 
       RowBox[{"-", "5"}]}], "}"}], ",", 
     RowBox[{"-", "10"}], ",", "0"}], "}"}]}], "]"}]], "Input",
