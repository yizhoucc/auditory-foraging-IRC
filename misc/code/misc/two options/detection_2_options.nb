Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{"Define", " ", "the", " ", "function"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"objectiveFunction", "[", 
     RowBox[{"h_", ",", "f_", ",", "\[Eta]_", ",", "\[Mu]_"}], "]"}], ":=", 
    RowBox[{
     RowBox[{"h", "*", 
      RowBox[{"Q", "[", 
       RowBox[{"\[Eta]", "-", "\[Mu]"}], "]"}]}], "+", 
     RowBox[{"f", "*", 
      RowBox[{"Q", "[", "\[Eta]", "]"}]}], "-", "\[Mu]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Specify", " ", "the", " ", "values", " ", "of", " ", "h", " ", "and", 
     " ", "f", " ", "for", " ", "which", " ", "you", " ", "want", " ", "to", 
     " ", "minimize", " ", "the", " ", "function"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"hValues", "=", 
     RowBox[{"{", 
      RowBox[{"3", ",", "4", ",", "5"}], "}"}]}], ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{
    "Replace", " ", "with", " ", "your", " ", "desired", " ", "values"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"fValues", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "6"}], ",", 
       RowBox[{"-", "5"}], ",", 
       RowBox[{"-", "4"}]}], "}"}]}], ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{
    "Replace", " ", "with", " ", "your", " ", "desired", " ", "values"}], 
    "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Perform", " ", "the", " ", "numerical", " ", "minimization", " ", "for", 
     " ", "each", " ", "combination", " ", "of", " ", "h", " ", "and", " ", 
     "f"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"minimizationResults", "=", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"NMinimize", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"objectiveFunction", "[", 
            RowBox[{"h", ",", "f", ",", "\[Eta]", ",", "\[Mu]"}], "]"}], ",", 
           
           RowBox[{"\[Eta]", "\[Element]", "Reals"}], ",", 
           RowBox[{"\[Mu]", "\[Element]", "Reals"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\[Eta]", ",", "\[Mu]"}], "}"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"h", ",", "hValues"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"f", ",", "fValues"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Extract", " ", "the", " ", "minimum", " ", "values", " ", "and", " ", 
     "corresponding", " ", "values", " ", "of", " ", "\[Eta]", " ", "and", 
     " ", "\[Mu]"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"minValues", "=", 
     RowBox[{"minimizationResults", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "All", ",", "1"}], "]"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"minArg", "=", 
     RowBox[{"minimizationResults", "[", 
      RowBox[{"[", 
       RowBox[{"All", ",", "All", ",", "2"}], "]"}], "]"}]}], ";"}], 
