Notebook[{
Cell["\<\
Classical detection problem between two Gaussian models. One having mean \
\[Mu] (stimulus present) and other with mean 0 (stimulus absent). Both have \
variance 1.
Let f be the reward per unit for false alarming (f < 0).
Let h be the reward per unit for getting a hit (f < 0).
We assume there is a cost for having a certain \[Mu]\
\>", "Text",
 CellChangeTimes->{{3.9088137100110197`*^9, 3.908813935842352*^9}, {
  3.908814078144105*^9, 3.908814103618381*^9}, {3.9088141922605352`*^9, 
  3.90881423131418*^9}, {3.9088143167359*^9, 3.908814409534336*^9}, {
  3.9088150913240967`*^9, 3.908815096569417*^9}, {3.908816393028627*^9, 
  3.908816402796625*^9}, {3.908816466642523*^9, 3.908816471567498*^9}, {
  3.908904070479237*^9, 3.9089042360670843`*^9}, {3.908904271774239*^9, 
  3.908904294734653*^9}},ExpressionUUID->"721d3aa7-63cb-43b0-bf62-\
c18597dc85df"],

Cell[BoxData[
 RowBox[{
  RowBox[{"Q", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"1", "/", "2"}], " ", 
   RowBox[{"Erfc", "[", 
    RowBox[{"x", "/", 
     RowBox[{"Sqrt", "[", "2", "]"}]}], "]"}]}]}]], "Input",
 CellLabel->
  "In[349]:=",ExpressionUUID->"bd2bc5be-127a-4018-8d33-5c3ad3a678ca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"reward", " ", "=", " ", 
   RowBox[{
    RowBox[{"h", " ", "*", " ", 
     RowBox[{"Q", "[", 
      RowBox[{"\[Eta]", "-", "\[Mu]"}], "]"}]}], "+", 
    RowBox[{"f", " ", 
     RowBox[{"Q", "[", "\[Eta]", "]"}]}], "-", "\[Mu]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.908904267091984*^9, 3.9089042677652187`*^9}, 
   3.9089043709404793`*^9, 3.908904425395905*^9, 3.9089403606433907`*^9},
 CellLabel->
  "In[351]:=",ExpressionUUID->"190da2d1-df91-4f10-92fe-63ce5ce5b8f3"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"D", "[", 
      RowBox[{"reward", ",", "\[Eta]"}], "]"}], "==", "0"}], " ", "&&", " ", 
    RowBox[{"f", "<", "0"}], " ", "&&", " ", 
    RowBox[{"h", ">", "0"}]}], ",", "\[Eta]", ",", "Reals"}], "]"}]], "Input",\

 CellChangeTimes->{{3.908904427248858*^9, 3.90890447400416*^9}},
 CellLabel->
  "In[352]:=",ExpressionUUID->"70d14a65-9205-48fc-a4e7-0521598f6557"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{"\[Eta]", "\[Rule]", 
    TemplateBox[{
      RowBox[{"-", 
        FractionBox[
         RowBox[{
           RowBox[{"-", 
             SuperscriptBox["\[Mu]", "2"]}], "-", 
           RowBox[{"2", " ", 
             RowBox[{"Log", "[", 
               RowBox[{"-", 
                 FractionBox["f", "h"]}], "]"}]}]}], 
         RowBox[{"2", " ", "\[Mu]"}]]}], 
      RowBox[{
        RowBox[{"f", "<", "0"}], "&&", 
        RowBox[{"h", ">", "0"}]}]},
     "ConditionalExpression"]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.908904479906702*^9},
 CellLabel->
  "Out[352]=",ExpressionUUID->"d3b769aa-b3b9-4cf0-89e3-fbc60e8e4512"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"D", "[", 
  RowBox[{"reward", ",", "\[Mu]"}], "]"}]], "Input",
 CellChangeTimes->{{3.908904498797175*^9, 3.908904503448572*^9}, {
  3.908904596953869*^9, 3.908904597630961*^9}, {3.9089046315961037`*^9, 
  3.90890464321381*^9}, {3.908904675479577*^9, 3.908904681371262*^9}},
 CellLabel->
  "In[357]:=",ExpressionUUID->"839c6558-25e6-4e23-a871-7145beac5caa"],

Cell[BoxData[
 RowBox[{
  RowBox[{"-", "1"}], "+", 
  FractionBox[
   RowBox[{
    SuperscriptBox["\[ExponentialE]", 
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], " ", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"\[Eta]", "-", "\[Mu]"}], ")"}], "2"]}]], " ", "h"}], 
   SqrtBox[
    RowBox[{"2", " ", "\[Pi]"}]]]}]], "Output",
 CellChangeTimes->{
  3.908904503977223*^9, {3.908904652543859*^9, 3.9089046821056843`*^9}},
 CellLabel->
  "Out[357]=",ExpressionUUID->"bb41f678-a8b5-4b8a-90d9-cb23207d2ca5"]
}, Open  ]],

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"2", " ", 
     RowBox[{"Log", "[", " ", 
      FractionBox[
       SqrtBox[
        RowBox[{"2", " ", "\[Pi]"}]], "h"], "]"}]}], "+", 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{"\[Eta]", "-", "\[Mu]"}], ")"}], "2"]}], "=", " ", 
   "0"}]}]], "Input",
 CellChangeTimes->{{3.9089046880010853`*^9, 
  3.908904770873048*^9}},ExpressionUUID->"b05b4cb1-89ea-4ff9-a33d-\
5359889faf22"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"2", " ", 
       RowBox[{"Log", "[", " ", 
        FractionBox[
         SqrtBox[
          RowBox[{"2", " ", "\[Pi]"}]], "h"], "]"}]}], "+", 
      SuperscriptBox[
       RowBox[{"(", 
        RowBox[{"\[Eta]", "-", "\[Mu]"}], ")"}], "2"]}], ")"}], "/.", 
    RowBox[{"{", 
     RowBox[{"\[Eta]", "->", " ", 
      RowBox[{"-", 
       FractionBox[
        RowBox[{
         RowBox[{"-", 
          SuperscriptBox["\[Mu]", "2"]}], "-", 
         RowBox[{"2", " ", 
          RowBox[{"Log", "[", 
           RowBox[{"-", 
            FractionBox["f", "h"]}], "]"}]}]}], 
        RowBox[{"2", " ", "\[Mu]"}]]}]}], "}"}]}], "//", 
   "Simplify"}]}]], "Input",
 CellChangeTimes->{{3.908904776262891*^9, 3.9089047877951183`*^9}, {
  3.908906010732292*^9, 3.908906013411817*^9}},
 CellLabel->
  "In[361]:=",ExpressionUUID->"8361ae15-eae4-4954-9a6a-6cfa19cea949"],

Cell[BoxData[
 RowBox[{
  RowBox[{"2", " ", 
   RowBox[{"Log", "[", 
    FractionBox["1", "h"], "]"}]}], "+", 
  FractionBox[
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{
      SuperscriptBox["\[Mu]", "2"], "-", 
      RowBox[{"2", " ", 
       RowBox[{"Log", "[", 
        RowBox[{"-", 
         FractionBox["f", "h"]}], "]"}]}]}], ")"}], "2"], 
   RowBox[{"4", " ", 
    SuperscriptBox["\[Mu]", "2"]}]], "+", 
  RowBox[{"Log", "[", 
   RowBox[{"2", " ", "\[Pi]"}], "]"}]}]], "Output",
 CellChangeTimes->{{3.90890478445091*^9, 3.908904788170689*^9}, 
   3.908906014172016*^9},
 CellLabel->
