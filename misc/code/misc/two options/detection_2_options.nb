}, Open  ]],

Cell["\<\
Once again assuming \[Mu] \[NotEqual] 0 (although we might have made this \
assumption before while calculating \[Eta]).\
\>", "Text",
 CellChangeTimes->{{3.9088137100110197`*^9, 3.908813935842352*^9}, {
  3.908814078144105*^9, 3.908814103618381*^9}, {3.9088141922605352`*^9, 
