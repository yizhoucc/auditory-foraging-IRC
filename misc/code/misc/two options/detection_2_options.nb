Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Mu]Sols", " ", "=", " ", 
   RowBox[{"\[Mu]", "/.", 
    RowBox[{"Solve", "[", 
     RowBox[{
      RowBox[{
       RowBox[{
        RowBox[{"2", "*", "4", " ", 
         SuperscriptBox["\[Mu]", "2"], " ", 
         RowBox[{"Log", "[", 
          FractionBox["1", "h"], "]"}]}], "+", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{
           SuperscriptBox["\[Mu]", "2"], "-", 
           RowBox[{"2", " ", 
            RowBox[{"Log", "[", 
             RowBox[{"-", 
              FractionBox["f", "h"]}], "]"}]}]}], ")"}], "2"], "+", 
        RowBox[{
         RowBox[{"Log", "[", 
          RowBox[{"2", " ", "\[Pi]"}], "]"}], "4", " ", 
         SuperscriptBox["\[Mu]", "2"]}]}], "==", "0"}], " ", ",", "\[Mu]", 
      ",", "Reals"}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Eta]Sols", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox["\[Mu]", "2"]}], "-", 
        RowBox[{"2", " ", 
         RowBox[{"Log", "[", 
          RowBox[{"-", 
           FractionBox["f", "h"]}], "]"}]}]}], 
       RowBox[{"2", " ", "\[Mu]"}]]}], ")"}], "/.", 
    RowBox[{"{", 
     RowBox[{"\[Mu]", "->", " ", "\[Mu]Sols"}], "}"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rewardSols", "=", 
   RowBox[{"reward", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"\[Mu]", "->", " ", "\[Mu]Sols"}], ",", " ", 
      RowBox[{"\[Eta]", "->", " ", "\[Eta]Sols"}]}], "}"}]}]}], 
  ";"}]}], "Input",
