Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"DiscretePlot", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"\[Lambda]", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Lambda]"}], " ", "k"}], " ", "]"}]}], "/.", 
      RowBox[{"{", 
       RowBox[{"\[Lambda]", "->", " ", 
        RowBox[{"1", "/", 
         RowBox[{"(", "distMean", ")"}]}]}], "}"}]}], ")"}], "-", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "-", "ptr"}], ")"}], 
        RowBox[{"(", 
         RowBox[{"k", "-", "1"}], ")"}]], "*", " ", "ptr"}], "/.", 
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ptr", "/", 
          RowBox[{"(", 
           RowBox[{"1", "-", "ptr"}], ")"}]}], "==", 
         RowBox[{"1", "/", 
          RowBox[{"(", "distMean", ")"}]}]}], ",", "ptr"}], "]"}]}], ")"}]}], 
   ",", 
   RowBox[{"{", 
    RowBox[{"k", ",", " ", "0", ",", 
     RowBox[{"20", "/", "timeStep"}], ",", "timeStep"}], "}"}], ",", 
   RowBox[{"Filling", "->", "Axis"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"StringForm", "[", 
       RowBox[{"\"\<Time (`` sec unit)\>\"", ",", "timeStep"}], "]"}], ",", 
      "\"\<Error in probability\>\""}], "}"}]}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{
    "{", "\"\<Approximation error besides binning error\>\"", "}"}]}]}], 
  "]"}]], "Input",
 CellChangeTimes->{{3.887807141540518*^9, 3.887807169431601*^9}, {
  3.8878072051043158`*^9, 3.8878072460944138`*^9}},
 CellLabel->"In[11]:=",ExpressionUUID->"71b2ac64-a8df-433f-bd8a-c0576993c5a2"],

