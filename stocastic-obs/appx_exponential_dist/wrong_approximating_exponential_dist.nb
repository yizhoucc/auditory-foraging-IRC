Cell[BoxData[
 RowBox[{"DiscretePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Lambda]", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Lambda]"}], " ", "k"}], " ", "]"}]}], "/.", 
      RowBox[{"{", 
       RowBox[{"\[Lambda]", "->", " ", 
        RowBox[{"1", "/", 
         RowBox[{"(", "distMean", ")"}]}]}], "}"}]}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"1", "-", "ptr"}], ")"}], 
         RowBox[{"(", 
          RowBox[{"k", "-", "1"}], ")"}]], "*", " ", "ptr"}], "/.", 
       RowBox[{"{", 
        RowBox[{"ptr", "->", " ", 
         RowBox[{"\[Lambda]", " ", 
          RowBox[{"Exp", "[", 
           RowBox[{"-", "\[Lambda]"}], "  ", "]"}]}]}], "}"}]}], "/.", 
      RowBox[{"{", 
       RowBox[{"\[Lambda]", "->", " ", 
        RowBox[{"1", "/", 
         RowBox[{"(", "distMean", ")"}]}]}], "}"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"k", ",", "0", ",", "20", ",", "1"}], "}"}], ",", 
   RowBox[{"Filling", "->", "Axis"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"StringForm", "[", 
       RowBox[{"\"\<Time (`` sec unit)\>\"", ",", "1"}], "]"}], ",", 
      "\"\<Probability\>\""}], "}"}]}], ",", 
   RowBox[{"PlotLegends", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<Exponential dist.\>\"", ",", "\"\<Discrete case\>\""}], 
     "}"}]}]}], "]"}]], "Input",
