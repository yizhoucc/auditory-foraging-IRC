Cell[BoxData[
 RowBox[{"DiscretePlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"\[Lambda]", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{
         RowBox[{"-", "\[Lambda]"}], " ", "k"}], " ", "]"}]}], "/.", 
      RowBox[{"{", 
       RowBox[{"\[Lambda]", "->", " ", 
        RowBox[{"1", "/", 
         RowBox[{"(", "distMean", ")"}]}]}], "}"}]}], ",", 
     RowBox[{
      RowBox[{
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "-", "ptr"}], ")"}], 
        RowBox[{"(", 
         RowBox[{"k", "-", "1"}], ")"}]], "*", " ", "ptr"}], "/.", 
      RowBox[{"Solve", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"ptr", "/", 
          RowBox[{"(", 
           RowBox[{"1", "-", "ptr"}], ")"}]}], "==", 
         RowBox[{"1", "/", 
          RowBox[{"(", "distMean", ")"}]}]}], ",", "ptr"}], "]"}]}]}], "}"}], 
